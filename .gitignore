.env*

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Note: each of frontend/, naive-store/, optimized-store/ has its own .gitignore
# for stack-specific rules (node_modules, .next, .venv, __pycache__, etc).
# Root-level ignores only, since patterns here are anchored to the repo root.

# misc
.DS_Store
*.pem

# large backup/archive files should never be committed
*.tar.gz
*.zip
